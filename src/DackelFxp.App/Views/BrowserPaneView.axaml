<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DackelFxp.App.ViewModels"
             xmlns:sites="using:DackelFxp.Core.Sites"
             xmlns:settings="using:DackelFxp.Core.Settings"
             xmlns:conv="using:DackelFxp.App.Converters"
             x:Class="DackelFxp.App.Views.BrowserPaneView"
             x:DataType="vm:BrowserPaneViewModel">
  <UserControl.Styles>
    <Style Selector="Button.tool">
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="MinWidth" Value="28" />
    </Style>
    <Style Selector="TextBlock.name.only">
      <Setter Property="Foreground" Value="MediumSeaGreen" />
    </Style>
    <Style Selector="TextBlock.name.diff">
      <Setter Property="Foreground" Value="Orange" />
    </Style>
    <Style Selector="TextBlock.name.same">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
  </UserControl.Styles>

  <!-- Transparent background: the empty area below the rows also receives clicks (middle click = up). -->
  <Panel Background="Transparent">
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="pane-header line-bottom" Classes.active="{Binding IsActive}">
      <StackPanel Spacing="4">
        <DockPanel>
          <Menu DockPanel.Dock="Left">
            <MenuItem Header="{Binding Title}" FontWeight="SemiBold" ItemsSource="{Binding Sites}" ToolTip.Tip="{DynamicResource Pane_ConnectTip}">
              <MenuItem.ItemContainerTheme>
                <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="sites:Site">
                  <Setter Property="Header" Value="{Binding DisplayName}" />
                  <Setter Property="Command" Value="{Binding $parent[UserControl].((vm:BrowserPaneViewModel)DataContext).ConnectCommand}" />
                  <Setter Property="CommandParameter" Value="{Binding}" />
                </ControlTheme>
              </MenuItem.ItemContainerTheme>
            </MenuItem>
            <MenuItem Header="★" ItemsSource="{Binding Bookmarks}" IsVisible="{Binding IsRemote}" ToolTip.Tip="{DynamicResource Pane_Bookmarks}">
              <MenuItem.ItemContainerTheme>
                <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="sites:Bookmark">
                  <Setter Property="Header" Value="{Binding Name}" />
                  <Setter Property="Command" Value="{Binding $parent[UserControl].((vm:BrowserPaneViewModel)DataContext).GoToBookmarkCommand}" />
                  <Setter Property="CommandParameter" Value="{Binding}" />
                </ControlTheme>
              </MenuItem.ItemContainerTheme>
            </MenuItem>
          </Menu>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2">
            <Button Classes="tool" Content="{DynamicResource Pane_Local}" Command="{Binding ConnectLocalCommand}" ToolTip.Tip="{DynamicResource Pane_LocalTip}" />
            <Button Classes="tool" Content="{DynamicResource Pane_Disconnect}" Command="{Binding DisconnectCommand}" IsVisible="{Binding IsRemote}" />
            <Button Classes="tool" Content="+★" Command="{Binding AddBookmarkCommand}" IsVisible="{Binding IsRemote}" ToolTip.Tip="{DynamicResource Pane_AddBookmark}" />
          </StackPanel>
          <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="4" MinWidth="40" Margin="8,0" VerticalAlignment="Center" />
        </DockPanel>
        <DockPanel>
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="2" Margin="0,0,4,0">
            <Button Classes="tool" Content="←" Command="{Binding BackCommand}" ToolTip.Tip="{DynamicResource Pane_Back}" />
            <Button Classes="tool" Content="↑" Command="{Binding UpCommand}" ToolTip.Tip="{DynamicResource Pane_Up}" />
            <Button Classes="tool" Content="⟳" Command="{Binding RefreshCommand}" ToolTip.Tip="{DynamicResource Pane_Refresh}" />
            <Button Classes="tool" Content="⌂" Command="{Binding HomeCommand}" ToolTip.Tip="{DynamicResource Pane_Home}" />
          </StackPanel>
          <TextBox DockPanel.Dock="Right" Width="110" PlaceholderText="{DynamicResource Pane_Filter}" Text="{Binding Filter}" Margin="4,0,0,0" />
          <TextBox Text="{Binding PathText}" x:Name="PathBox">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding NavigateToPathTextCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
        </DockPanel>
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Classes="line-top" Padding="6,2">
      <TextBlock Text="{Binding StatusText}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" />
    </Border>

    <DataGrid x:Name="Grid" ItemsSource="{Binding Items}" SelectionMode="Extended" CanUserReorderColumns="True" DragDrop.AllowDrop="True" Background="Transparent">
      <DataGrid.ContextMenu>
        <ContextMenu>
          <MenuItem Header="{DynamicResource Ctx_Transfer}" InputGesture="Ctrl+T" Command="{Binding TransferSelectedCommand}" />
          <MenuItem Header="{DynamicResource Ctx_Queue}" InputGesture="Ctrl+Q" Command="{Binding QueueSelectedCommand}" />
          <Separator />
          <MenuItem Header="{DynamicResource Ctx_ViewEdit}" InputGesture="F3" Command="{Binding ViewEditCommand}" />
          <MenuItem Header="{DynamicResource Ctx_Rename}" InputGesture="F2" Command="{Binding RenameCommand}" />
          <MenuItem Header="{DynamicResource Ctx_Delete}" InputGesture="Delete" Command="{Binding DeleteCommand}" />
          <MenuItem Header="{DynamicResource Ctx_NewFolder}" InputGesture="F7" Command="{Binding MakeDirectoryCommand}" />
          <MenuItem Header="{DynamicResource Ctx_Chmod}" Command="{Binding ChmodCommand}" IsVisible="{Binding IsRemote}" />
          <Separator />
          <MenuItem Header="{DynamicResource Ctx_SendCommand}" Command="{Binding RawCommandCommand}" IsVisible="{Binding IsRemote}" />
          <MenuItem Header="{DynamicResource Ctx_CustomCommands}" ItemsSource="{Binding CustomCommands}" IsVisible="{Binding IsRemote}">
            <MenuItem.ItemContainerTheme>
              <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="settings:CustomCommand">
                <Setter Property="Header" Value="{Binding Name}" />
                <Setter Property="Command" Value="{Binding $parent[UserControl].((vm:BrowserPaneViewModel)DataContext).RunCustomCommandCommand}" />
                <Setter Property="CommandParameter" Value="{Binding}" />
              </ControlTheme>
            </MenuItem.ItemContainerTheme>
          </MenuItem>
          <MenuItem Header="{DynamicResource Ctx_VerifySfv}" Command="{Binding VerifySfvCommand}" />
          <Separator />
          <MenuItem Header="{DynamicResource Ctx_Refresh}" InputGesture="F5" Command="{Binding RefreshCommand}" />
        </ContextMenu>
      </DataGrid.ContextMenu>
      <!-- Tag = key of the column layout in the settings. Right-click on a header: show/hide columns. -->
      <DataGrid.Columns>
        <DataGridTemplateColumn Tag="Name" Width="*" SortMemberPath="SortName" MinWidth="120">
          <DataGridTemplateColumn.Header>
            <TextBlock Text="{DynamicResource Col_Name}" />
          </DataGridTemplateColumn.Header>
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:FileEntryViewModel">
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="6,0">
                <PathIcon Width="14" Height="14" Data="{Binding IconKey, Converter={x:Static conv:IconConverter.Instance}}" Foreground="{Binding IconBrush}" />
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Classes="name"
                           Classes.only="{Binding IsCompareOnly}" Classes.diff="{Binding IsCompareDifferent}" Classes.same="{Binding IsCompareSame}" />
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Tag="Size" Width="90" SortMemberPath="Size">
          <DataGridTemplateColumn.Header>
            <TextBlock Text="{DynamicResource Col_Size}" />
          </DataGridTemplateColumn.Header>
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:FileEntryViewModel">
              <TextBlock Text="{Binding SizeText}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="6,0" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Tag="Date" Width="145" SortMemberPath="Modified">
          <DataGridTemplateColumn.Header>
            <TextBlock Text="{DynamicResource Col_Date}" />
          </DataGridTemplateColumn.Header>
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:FileEntryViewModel">
              <TextBlock Text="{Binding ModifiedText}" VerticalAlignment="Center" Margin="6,0" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Tag="Permissions" Width="100" SortMemberPath="Permissions">
          <DataGridTemplateColumn.Header>
            <TextBlock Text="{DynamicResource Col_Permissions}" />
          </DataGridTemplateColumn.Header>
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:FileEntryViewModel">
              <TextBlock Text="{Binding Permissions}" VerticalAlignment="Center" Margin="6,0" Classes="log" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Tag="Owner" Width="100" SortMemberPath="Owner">
          <DataGridTemplateColumn.Header>
            <TextBlock Text="{DynamicResource Col_Owner}" />
          </DataGridTemplateColumn.Header>
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:FileEntryViewModel">
              <TextBlock Text="{Binding Owner}" VerticalAlignment="Center" Margin="6,0" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
    <!-- Shown while entries from the other pane are dragged over this one. -->
    <Border x:Name="DropOverlay" IsVisible="False" IsHitTestVisible="False"
            BorderBrush="{DynamicResource SystemAccentColor}" BorderThickness="2">
      <Border.Background>
        <SolidColorBrush Color="{DynamicResource SystemAccentColor}" Opacity="0.12" />
      </Border.Background>
    </Border>
  </Panel>
</UserControl>
