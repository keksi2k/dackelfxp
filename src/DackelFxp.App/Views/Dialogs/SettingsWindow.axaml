<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DackelFxp.App.ViewModels"
        xmlns:rules="using:DackelFxp.Core.Rules"
        xmlns:settings="using:DackelFxp.Core.Settings"
        x:Class="DackelFxp.App.Views.Dialogs.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="{DynamicResource Title_Settings}" Width="900" Height="620" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Window.Styles>
    <Style Selector="Grid.form > TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,12,0" />
    </Style>
    <Style Selector="Grid.form > :is(Control)">
      <Setter Property="Margin" Value="0,3" />
    </Style>
    <Style Selector="NumericUpDown">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Width" Value="140" />
    </Style>
  </Window.Styles>

  <DockPanel Margin="10">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button Content="{DynamicResource Btn_Save}" Command="{Binding SaveCommand}" IsDefault="True" />
      <Button Content="{DynamicResource Btn_Cancel}" Command="{Binding CancelCommand}" IsCancel="True" />
    </StackPanel>

    <TabControl TabStripPlacement="Left">
      <TabItem Header="{DynamicResource Tab_General}">
        <ScrollViewer>
          <Grid Classes="form" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="8">
            <TextBlock Grid.Row="0" Text="{DynamicResource Set_Slots}" />
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="10">
              <NumericUpDown Value="{Binding Settings.TransferSlots}" Minimum="1" Maximum="20" FormatString="0" />
              <TextBlock Text="{DynamicResource Set_SlotsHint}" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="380" />
            </StackPanel>
            <TextBlock Grid.Row="1" Text="{DynamicResource Set_GlobalLimit}" />
            <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding Settings.GlobalSpeedLimitKb}" Minimum="0" Maximum="10000000" FormatString="0" />
            <TextBlock Grid.Row="2" Text="{DynamicResource Set_IdleDisconnect}" />
            <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding Settings.IdleDisconnectMinutes}" Minimum="0" Maximum="1440" FormatString="0" />
            <TextBlock Grid.Row="3" Text="{DynamicResource Set_AfterQueue}" />
            <ComboBox Classes="enum" Grid.Row="3" Grid.Column="1" ItemsSource="{x:Static vm:SettingsViewModel.CompletionActions}" SelectedItem="{Binding Settings.OnQueueComplete}" />
            <TextBlock Grid.Row="6" Text="{DynamicResource Set_Language}" />
            <ComboBox Grid.Row="6" Grid.Column="1" Classes="enum" ItemsSource="{x:Static vm:SettingsViewModel.Languages}" SelectedItem="{Binding Settings.Language}" />
            <TextBlock Grid.Row="4" Text="{DynamicResource Set_Theme}" />
            <ComboBox Classes="enum" Grid.Row="4" Grid.Column="1" ItemsSource="{x:Static vm:SettingsViewModel.Themes}" SelectedItem="{Binding Settings.Theme}" />
            <TextBlock Grid.Row="5" Text="" />
            <StackPanel Grid.Row="5" Grid.Column="1" Spacing="2">
              <CheckBox Content="{DynamicResource Set_FilesFirst}" IsChecked="{Binding Settings.TransferFilesBeforeFolders}" />
              <CheckBox Content="{DynamicResource Set_PreserveTime}" IsChecked="{Binding Settings.PreserveTimestamps}" />
              <CheckBox Content="{DynamicResource Set_VerifySfv}" IsChecked="{Binding Settings.VerifySfvAfterDownload}" />
              <CheckBox Content="{DynamicResource Set_SortLinks}" IsChecked="{Binding Settings.SortLinksOnTop}" />
              <CheckBox Content="{DynamicResource Queue_AutoRemove}" IsChecked="{Binding Settings.RemoveFinishedItems}" />
            </StackPanel>
                      <TextBlock Grid.Row="7" Text="{DynamicResource Set_Font}" />
            <ComboBox Grid.Row="7" Grid.Column="1" ItemsSource="{x:Static vm:SettingsViewModel.FontNames}" SelectedItem="{Binding Settings.FontFamily}"
                      MinWidth="260" MaxDropDownHeight="400">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding}" FontFamily="{Binding}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Grid.Row="8" Text="{DynamicResource Set_ListFontSize}" />
            <NumericUpDown Grid.Row="8" Grid.Column="1" Value="{Binding Settings.ListFontSize}" Minimum="8" Maximum="32" Increment="1" FormatString="0" />
          </Grid>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{DynamicResource Tab_FileExists}">
        <Grid Classes="form" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="8">
          <TextBlock Grid.Row="0" Text="{DynamicResource Exists_Smaller}" />
          <ComboBox Classes="enum" Grid.Row="0" Grid.Column="1" ItemsSource="{x:Static vm:SettingsViewModel.ExistsActions}" SelectedItem="{Binding Settings.FileExists.WhenSmaller}" />
          <TextBlock Grid.Row="1" Text="{DynamicResource Exists_Equal}" />
          <ComboBox Classes="enum" Grid.Row="1" Grid.Column="1" ItemsSource="{x:Static vm:SettingsViewModel.ExistsActions}" SelectedItem="{Binding Settings.FileExists.WhenEqual}" />
          <TextBlock Grid.Row="2" Text="{DynamicResource Exists_Larger}" />
          <ComboBox Classes="enum" Grid.Row="2" Grid.Column="1" ItemsSource="{x:Static vm:SettingsViewModel.ExistsActions}" SelectedItem="{Binding Settings.FileExists.WhenLarger}" />
          <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Classes="muted" TextWrapping="Wrap" Margin="0,10,0,0"
                     Text="{DynamicResource Exists_Help}" />
        </Grid>
      </TabItem>

      <TabItem Header="{DynamicResource Tab_Skiplists}">
        <DockPanel Margin="8">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
            <ComboBox ItemsSource="{Binding SkipLists}" SelectedItem="{Binding SelectedSkipList}" MinWidth="200">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="rules:SkipList">
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Content="{DynamicResource Skip_NewList}" Command="{Binding AddSkipListCommand}" />
            <Button Content="{DynamicResource Skip_DeleteList}" Command="{Binding RemoveSkipListCommand}" />
            <TextBlock Text="{DynamicResource Skip_Default}" VerticalAlignment="Center" Margin="12,0,0,0" />
            <TextBox Text="{Binding Settings.DefaultSkipList}" Width="140" />
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
            <Button Content="{DynamicResource Skip_AddRule}" Command="{Binding AddRuleCommand}" />
            <Button Content="{DynamicResource Skip_RemoveRule}" Command="{Binding RemoveRuleCommand}" />
            <TextBlock Classes="muted" VerticalAlignment="Center" Text="{DynamicResource Skip_Help}" />
          </StackPanel>
          <DataGrid ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}" IsReadOnly="False" CanUserSortColumns="False" RowHeight="32">
            <DataGrid.Columns>
              <DataGridTemplateColumn Width="62">
          <DataGridTemplateColumn.Header><TextBlock Text="{DynamicResource Lbl_Active}" /></DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="rules:SkipRule">
                    <CheckBox IsChecked="{Binding Enabled}" HorizontalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Width="*">
          <DataGridTemplateColumn.Header><TextBlock Text="{DynamicResource Col_Pattern}" /></DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="rules:SkipRule">
                    <TextBox Text="{Binding Pattern}" BorderThickness="0" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Regex" Width="66">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="rules:SkipRule">
                    <CheckBox IsChecked="{Binding IsRegex}" HorizontalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Width="130">
          <DataGridTemplateColumn.Header><TextBlock Text="{DynamicResource Col_For}" /></DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="rules:SkipRule">
                    <ComboBox Classes="enum" ItemsSource="{x:Static vm:SettingsViewModel.RuleTargets}" SelectedItem="{Binding Target}" HorizontalAlignment="Stretch" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Width="120">
          <DataGridTemplateColumn.Header><TextBlock Text="{DynamicResource Lbl_Action}" /></DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="rules:SkipRule">
                    <ComboBox Classes="enum" ItemsSource="{x:Static vm:SettingsViewModel.RuleActions}" SelectedItem="{Binding Action}" HorizontalAlignment="Stretch" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Width="140">
          <DataGridTemplateColumn.Header><TextBlock Text="{DynamicResource Col_Priority}" /></DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="rules:SkipRule">
                    <NumericUpDown Value="{Binding Priority}" Minimum="-1000" Maximum="1000" FormatString="0" Width="130" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <TabItem Header="{DynamicResource Tab_Commands}">
        <Grid ColumnDefinitions="220,8,*" Margin="8">
          <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
              <Button Content="{DynamicResource Btn_New}" Command="{Binding AddCommandCommand}" />
              <Button Content="{DynamicResource Btn_Remove}" Command="{Binding RemoveCommandCommand}" />
            </StackPanel>
            <ListBox ItemsSource="{Binding Commands}" SelectedItem="{Binding SelectedCommand}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="settings:CustomCommand">
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
          <StackPanel Grid.Column="2" Spacing="6" IsVisible="{Binding SelectedCommand, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="Name" />
            <TextBox Text="{Binding SelectedCommand.Name}" />
            <TextBlock Text="{DynamicResource Cmd_Lines}" />
            <TextBox Text="{Binding SelectedCommand.Commands}" AcceptsReturn="True" Height="160" Classes="log" />
            <CheckBox Content="{DynamicResource Cmd_AskParameter}" IsChecked="{Binding SelectedCommand.AskForParameter}" />
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="{DynamicResource Cmd_Help}" />
          </StackPanel>
        </Grid>
      </TabItem>

      <TabItem Header="{DynamicResource Tab_Scheduler}">
        <Grid ColumnDefinitions="260,8,*" Margin="8">
          <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
              <Button Content="{DynamicResource Btn_New}" Command="{Binding AddScheduleCommand}" />
              <Button Content="{DynamicResource Btn_Remove}" Command="{Binding RemoveScheduleCommand}" />
            </StackPanel>
            <ListBox ItemsSource="{Binding Schedules}" SelectedItem="{Binding SelectedSchedule}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ScheduleEntryViewModel">
                  <TextBlock Text="{Binding Summary}" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
          <Grid Grid.Column="2" Classes="form" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                IsVisible="{Binding SelectedSchedule, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Grid.Row="0" Text="Name" />
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedSchedule.Name}" />
            <TextBlock Grid.Row="1" Text="{DynamicResource Lbl_Active}" />
            <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding SelectedSchedule.Enabled}" />
            <TextBlock Grid.Row="2" Text="{DynamicResource Lbl_Action}" />
            <ComboBox Classes="enum" Grid.Row="2" Grid.Column="1" ItemsSource="{x:Static vm:SettingsViewModel.ScheduleActions}" SelectedItem="{Binding SelectedSchedule.Action}" />
            <TextBlock Grid.Row="3" Text="{DynamicResource Sched_Time}" />
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SelectedSchedule.TimeText}" Width="100" HorizontalAlignment="Left" />
            <TextBlock Grid.Row="4" Text="{DynamicResource Sched_Days}" />
            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="4">
              <CheckBox Content="{DynamicResource Day_Mo}" IsChecked="{Binding SelectedSchedule.Mon}" />
              <CheckBox Content="{DynamicResource Day_Tu}" IsChecked="{Binding SelectedSchedule.Tue}" />
              <CheckBox Content="{DynamicResource Day_We}" IsChecked="{Binding SelectedSchedule.Wed}" />
              <CheckBox Content="{DynamicResource Day_Th}" IsChecked="{Binding SelectedSchedule.Thu}" />
              <CheckBox Content="{DynamicResource Day_Fr}" IsChecked="{Binding SelectedSchedule.Fri}" />
              <CheckBox Content="{DynamicResource Day_Sa}" IsChecked="{Binding SelectedSchedule.Sat}" />
              <CheckBox Content="{DynamicResource Day_Su}" IsChecked="{Binding SelectedSchedule.Sun}" />
            </StackPanel>
            <TextBlock Grid.Row="5" Text="{DynamicResource Sched_Date}" />
            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding SelectedSchedule.DateText}" PlaceholderText="{DynamicResource Sched_DatePlaceholder}" Width="220" HorizontalAlignment="Left" />
            <TextBlock Grid.Row="6" Text="{DynamicResource Sched_QueueFile}" />
            <DockPanel Grid.Row="6" Grid.Column="1">
              <Button DockPanel.Dock="Right" Content="..." Command="{Binding PickScheduleQueueCommand}" Margin="6,0,0,0" />
              <TextBox Text="{Binding SelectedSchedule.QueueFile}" PlaceholderText="{DynamicResource Sched_QueuePlaceholder}" />
            </DockPanel>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem Header="Ident">
        <Grid Classes="form" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="8">
          <TextBlock Grid.Row="0" Text="{DynamicResource Ident_Server}" />
          <CheckBox Grid.Row="0" Grid.Column="1" Content="{DynamicResource Ident_Enabled}" IsChecked="{Binding Settings.IdentEnabled}" />
          <TextBlock Grid.Row="1" Text="Port" />
          <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding Settings.IdentPort}" Minimum="1" Maximum="65535" FormatString="0" />
          <TextBlock Grid.Row="2" Text="{DynamicResource Lbl_User}" />
          <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Settings.IdentUser}" />
          <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Classes="muted" TextWrapping="Wrap" Margin="0,10,0,0"
                     Text="{DynamicResource Ident_Help}" />
        </Grid>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
