<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DackelFxp.App.ViewModels"
        xmlns:views="using:DackelFxp.App.Views"
        xmlns:sites="using:DackelFxp.Core.Sites"
        x:Class="DackelFxp.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="DackelFXP"
        Width="1400" Height="900" MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen">

  <Window.KeyBindings>
    <KeyBinding Gesture="F4" Command="{Binding OpenSiteManagerCommand}" />
    <KeyBinding Gesture="F8" Command="{Binding QuickConnectCommand}" />
    <KeyBinding Gesture="Ctrl+M" Command="{Binding CompareFoldersCommand}" />
    <KeyBinding Gesture="F9" Command="{Binding Queue.StartCommand}" />
    <KeyBinding Gesture="Shift+F9" Command="{Binding Queue.StopCommand}" />
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenSettingsCommand}" />
    <KeyBinding Gesture="Ctrl+K" Command="{Binding FocusCommandLineCommand}" />
  </Window.KeyBindings>

  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="line-bottom">
      <Menu>
        <MenuItem Header="{DynamicResource Menu_Sites}">
          <MenuItem Header="{DynamicResource Menu_SiteManager}" InputGesture="F4" Command="{Binding OpenSiteManagerCommand}" />
          <MenuItem Header="{DynamicResource Menu_QuickConnect}" InputGesture="F8" Command="{Binding QuickConnectCommand}" />
          <MenuItem Header="{DynamicResource Menu_ConnectTo}" ItemsSource="{Binding Sites}">
            <MenuItem.ItemContainerTheme>
              <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="sites:Site">
                <Setter Property="Header" Value="{Binding DisplayName}" />
                <Setter Property="Command" Value="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ConnectSiteCommand}" />
                <Setter Property="CommandParameter" Value="{Binding}" />
              </ControlTheme>
            </MenuItem.ItemContainerTheme>
          </MenuItem>
          <Separator />
          <MenuItem Header="{DynamicResource Menu_DisconnectAll}" Command="{Binding DisconnectAllCommand}" />
          <MenuItem Header="{DynamicResource Menu_MasterPassword}" Command="{Binding SetMasterPasswordCommand}" />
          <Separator />
          <MenuItem Header="{DynamicResource Menu_Exit}" Command="{Binding ExitCommand}" />
        </MenuItem>
        <MenuItem Header="{DynamicResource Menu_Queue}">
          <MenuItem Header="{DynamicResource Menu_QueueStart}" InputGesture="F9" Command="{Binding Queue.StartCommand}" />
          <MenuItem Header="{DynamicResource Menu_QueueStop}" InputGesture="Shift+F9" Command="{Binding Queue.StopCommand}" />
          <Separator />
          <MenuItem Header="{DynamicResource Menu_RetryFailed}" Command="{Binding Queue.RetryAllFailedCommand}" />
          <MenuItem Header="{DynamicResource Menu_RemoveFinished}" Command="{Binding Queue.RemoveFinishedCommand}" />
          <MenuItem Header="{DynamicResource Menu_ClearQueue}" Command="{Binding Queue.ClearCommand}" />
          <Separator />
          <MenuItem Header="{DynamicResource Menu_SaveQueue}" Command="{Binding Queue.SaveCommand}" />
          <MenuItem Header="{DynamicResource Menu_LoadQueue}" Command="{Binding Queue.LoadCommand}" />
        </MenuItem>
        <MenuItem Header="{DynamicResource Menu_Tools}">
          <MenuItem Header="{DynamicResource Menu_Compare}" InputGesture="Ctrl+M" Command="{Binding CompareFoldersCommand}" />
          <MenuItem Header="{DynamicResource Menu_ClearCompare}" Command="{Binding ClearCompareCommand}" />
          <MenuItem Header="{DynamicResource Menu_QueueDifferences}" Command="{Binding TransferDifferencesCommand}" />
          <Separator />
          <MenuItem Header="{DynamicResource Menu_CommandLine}" InputGesture="Ctrl+K" Command="{Binding FocusCommandLineCommand}" />
          <Separator />
          <MenuItem Header="{DynamicResource Menu_Settings}" InputGesture="Ctrl+O" Command="{Binding OpenSettingsCommand}" />
          <MenuItem Header="{DynamicResource Menu_Language}">
            <MenuItem Header="Deutsch" Command="{Binding SetLanguageCommand}" CommandParameter="de"
                      ToggleType="Radio" IsChecked="{Binding IsGerman, Mode=OneWay}" />
            <MenuItem Header="English" Command="{Binding SetLanguageCommand}" CommandParameter="en"
                      ToggleType="Radio" IsChecked="{Binding !IsGerman, Mode=OneWay}" />
          </MenuItem>
        </MenuItem>
        <MenuItem Header="{DynamicResource Menu_Help}">
          <MenuItem Header="{DynamicResource Menu_About}" Command="{Binding AboutCommand}" />
        </MenuItem>
      </Menu>
    </Border>

    <Border DockPanel.Dock="Bottom" Classes="line-top" Padding="6,3" Background="{DynamicResource AreaHeaderBrush}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="{Binding Queue.TotalSpeed}" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Queue.Summary}" Classes="muted" />
      </DockPanel>
    </Border>

    <Grid RowDefinitions="*,7,250" Margin="4">
      <Grid ColumnDefinitions="*,7,*">
        <Border Grid.Column="0" Classes="area">
          <views:BrowserPaneView DataContext="{Binding Left}" x:Name="LeftPane" />
        </Border>
        <GridSplitter Grid.Column="1" ResizeDirection="Columns" />
        <Border Grid.Column="2" Classes="area">
          <views:BrowserPaneView DataContext="{Binding Right}" x:Name="RightPane" />
        </Border>
      </Grid>
      <GridSplitter Grid.Row="1" ResizeDirection="Rows" />
      <Border Grid.Row="2" Classes="area">
        <TabControl Padding="0" SelectedIndex="{Binding BottomTabIndex}">
          <TabItem Header="{DynamicResource Tab_Queue}">
            <Border Classes="line-top">
              <views:QueueView DataContext="{Binding Queue}" />
            </Border>
          </TabItem>
          <TabItem Header="{DynamicResource Tab_Log}">
            <Border Classes="line-top">
              <DockPanel>
                <Border DockPanel.Dock="Bottom" Classes="line-top">
                  <views:CommandBarView DataContext="{Binding CommandBar}" x:Name="CommandBar" />
                </Border>
                <views:LogView DataContext="{Binding Log}" />
              </DockPanel>
            </Border>
          </TabItem>
        </TabControl>
      </Border>
    </Grid>
  </DockPanel>
</Window>
